      <p>${s.desc}</p>
      <div class="service-price mono">from $${s.price}</div>
      <button class="btn btn-ghost btn-sm add-service" data-id="${s.id}" style="align-self:flex-start;">Add To Cart</button>
    </div>
  `).join('');

  serviceGrid.addEventListener('click', (e)=>{
