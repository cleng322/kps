          </div>
        </div>
      `).join('');
    }
    const total = cart.reduce((sum,i)=>sum+i.price,0);
    cartSubtotalEl.textContent = '$'+total;
  }
  cartItemsEl.addEventListener('click', (e)=>{
    const btn = e.target.closest('.cart-remove');
    if(!btn) return;
    removeFromCart(btn.dataset.key);
  });

  function openCart(){ cartDrawer.classList.add('open'); overlay.classList.add('open'); }
  function closeCart(){ cartDrawer.classList.remove('open'); overlay.classList.remove('open'); }
  document.getElementById('cartBtn').addEventListener('click', openCart);
  document.getElementById('cartClose').addEventListener('click', closeCart);
  overlay.addEventListener('click', closeCart);

  document.getElementById('checkoutBtn').addEventListener('click', (e)=>{
    e.preventDefault();
    if(cart.length===0){ showToast('Your cart is empty'); return; }
    const lines = cart.map(i => '- ' + i.name + ' (' + i.meta + ') — $' + i.price).join('\n');
    const total = cartSubtotalEl.textContent;
    const body = encodeURIComponent(
      'Order Request:\n\n'+lines+'\n\nEstimated total: '+total+'\n\nName:\nPhone:\nPreferred location (Hanover / Boonton / Jersey City):\nPreferred day/time:'
    );
    window.location.href = 'mailto:info@kurtsproshop.example?subject=Order%20Request&body='+body;
  });

  renderCart();

  /* ---------------- toast ---------------- */
  let toastTimer;
  function showToast(msg){
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(()=>t.classList.remove('show'), 2200);
  }
</script>

</body>
</html>
