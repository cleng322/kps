<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kurt's Pro Shop — Where Bowlers Come First</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Playfair+Display:ital@0;1&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --walnut-950:#221609;
    --walnut-900:#2b1c0d;
    --walnut-800:#3c2814;
    --walnut-700:#4f341c;
    --maple:#d9a15b;
    --maple-light:#f0c98a;
    --cream:#f3e8d3;
    --cream-dim:#cbbba0;
    --pin-red:#af2436;
    --pin-red-light:#d24b57;
    --gold:#c9982f;
    --ink:#1c140d;
    --steel:#a89b87;
    --line: rgba(243,232,211,0.14);
    --radius: 4px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--walnut-950);
    color:var(--cream);
    font-family:'Work Sans', sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,h4{
    font-family:'Anton', sans-serif;
    font-weight:400;
    letter-spacing:0.01em;
    text-transform:uppercase;
    margin:0;
    color:var(--cream);
  }
  .mono{font-family:'JetBrains Mono', monospace;}
  .quote-font{font-family:'Playfair Display', serif; font-style:italic;}
  a{color:inherit;}
  .wrap{max-width:1120px;margin:0 auto;padding:0 28px;}
  img{max-width:100%;display:block;}
  button{font-family:inherit;}

  /* ---------- HEADER ---------- */
  header{
    position:sticky; top:0; z-index:60;
    background:rgba(34,22,9,0.94);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 28px;
    max-width:1120px; margin:0 auto;
  }
  .brand{display:flex; align-items:center; gap:12px;}
  .brand svg{width:34px;height:34px;flex-shrink:0;}
  .brand-text{display:flex; flex-direction:column; line-height:1;}
  .brand-text .k1{font-family:'Anton',sans-serif; font-size:20px; letter-spacing:0.03em; color:var(--cream);}
  .brand-text .k2{font-family:'Playfair Display',serif; font-style:italic; font-size:11px; letter-spacing:0.02em; color:var(--maple); margin-top:3px;}

  nav.tabs{display:flex; gap:4px; background:var(--walnut-900); padding:5px; border-radius:999px; border:1px solid var(--line);}
  nav.tabs button{
    font-family:'JetBrains Mono',monospace;
    font-size:12px; letter-spacing:0.06em; text-transform:uppercase;
    background:transparent; border:none; color:var(--cream-dim);
    padding:9px 16px; border-radius:999px; cursor:pointer;
    transition:background .2s ease, color .2s ease;
  }
  nav.tabs button:hover{color:var(--cream);}
  nav.tabs button.active{background:var(--pin-red); color:var(--cream);}

  .nav-right{display:flex; align-items:center; gap:10px;}
  .fb-link{
    display:flex; align-items:center; gap:8px;
    border:1px solid var(--line); padding:8px 14px; border-radius:999px;
    font-family:'JetBrains Mono',monospace; font-size:12px;
    color:var(--cream-dim); text-decoration:none;
    transition:border-color .2s ease, color .2s ease;
  }
  .fb-link:hover{border-color:var(--maple); color:var(--maple-light);}
  .fb-link svg{width:15px;height:15px;}

  .cart-btn{
    position:relative; display:flex; align-items:center; gap:8px;
    background:var(--walnut-800); border:1px solid var(--line); color:var(--cream);
    padding:9px 16px; border-radius:999px; cursor:pointer; font-family:'JetBrains Mono',monospace; font-size:12px;
    transition:border-color .2s ease;
  }
  .cart-btn:hover{border-color:var(--maple);}
  .cart-btn svg{width:16px;height:16px;}
  .cart-count{
    background:var(--pin-red); color:var(--cream); font-size:10px; min-width:17px; height:17px;
    border-radius:999px; display:flex; align-items:center; justify-content:center; padding:0 4px;
  }

  .menu-toggle{display:none;background:none;border:1px solid var(--line);color:var(--cream);border-radius:6px;padding:8px 10px;cursor:pointer;font-size:18px;}

  @media (max-width:940px){
    nav.tabs{position:fixed; left:16px; right:16px; top:70px; flex-direction:column; background:var(--walnut-900); border-radius:14px; display:none; padding:10px; z-index:55;}
    nav.tabs.open{display:flex;}
    nav.tabs button{text-align:left;}
    .menu-toggle{display:block;}
    .fb-link span{display:none;}
  }

  /* ---------- CART DRAWER ---------- */
  .overlay{position:fixed; inset:0; background:rgba(0,0,0,0.5); opacity:0; pointer-events:none; transition:opacity .25s ease; z-index:70;}
  .overlay.open{opacity:1; pointer-events:auto;}
  .cart-drawer{
    position:fixed; top:0; right:0; height:100%; width:400px; max-width:92vw;
    background:var(--walnut-900); border-left:1px solid var(--line);
    transform:translateX(100%); transition:transform .3s ease; z-index:80;
    display:flex; flex-direction:column;
  }
  .cart-drawer.open{transform:translateX(0);}
  .cart-head{display:flex; justify-content:space-between; align-items:center; padding:22px 24px; border-bottom:1px solid var(--line);}
  .cart-head h3{font-size:20px;}
  .cart-close{background:none;border:1px solid var(--line);color:var(--cream);border-radius:6px;width:32px;height:32px;cursor:pointer;font-size:16px;}
  .cart-items{flex:1; overflow-y:auto; padding:12px 24px;}
  .cart-empty{color:var(--steel); font-size:14px; padding:30px 0; text-align:center;}
  .cart-item{display:flex; gap:12px; padding:16px 0; border-bottom:1px dashed var(--line);}
  .cart-item-thumb{width:46px;height:46px;border-radius:50%; background:var(--walnut-800); border:2px solid var(--pin-red); flex-shrink:0;}
  .cart-item-body{flex:1;}
  .cart-item-name{font-weight:600; font-size:14px;}
  .cart-item-meta{font-size:12px; color:var(--steel); margin-top:2px;}
  .cart-item-bottom{display:flex; justify-content:space-between; align-items:center; margin-top:8px;}
  .cart-item-price{font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--maple-light);}
  .cart-remove{background:none;border:none;color:var(--steel); cursor:pointer; font-size:12px; text-decoration:underline;}
  .cart-remove:hover{color:var(--pin-red-light);}
  .cart-foot{padding:20px 24px; border-top:1px solid var(--line);}
  .cart-subtotal{display:flex; justify-content:space-between; font-family:'Anton',sans-serif; font-size:22px; color:var(--maple-light); margin-bottom:14px;}
  .cart-note{font-size:12px; color:var(--steel); margin-top:12px; line-height:1.5;}

  /* ---------- SECTIONS ---------- */
  section{display:none; animation:fade .4s ease;}
  section.active{display:block;}
  @keyframes fade{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

  /* ---------- HERO ---------- */
  .hero{
    position:relative; overflow:hidden;
    padding:90px 0 60px;
    border-bottom:1px solid var(--line);
    background:
      radial-gradient(ellipse 900px 500px at 80% -10%, rgba(217,161,91,0.12), transparent 60%),
      linear-gradient(180deg, var(--walnut-900), var(--walnut-950));
  }
  .hero-grid{display:grid; grid-template-columns:1.15fr 0.85fr; gap:50px; align-items:center;}
  @media (max-width:900px){.hero-grid{grid-template-columns:1fr;}}
  .eyebrow{
    font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.22em;
    color:var(--maple); text-transform:uppercase; margin-bottom:18px; display:flex; align-items:center; gap:10px;
  }
  .eyebrow::before{content:"";width:26px;height:1px;background:var(--maple);display:inline-block;}
  .hero h1{
    font-size:clamp(40px, 6.4vw, 76px);
    line-height:0.96;
    color:var(--cream);
  }
  .hero h1 span{color:var(--pin-red-light);}
  .hero-quote{
    font-size:clamp(20px,2.4vw,26px); color:var(--maple-light); margin-top:20px;
  }
  .hero p.lead{
    margin-top:16px; max-width:480px; color:var(--cream-dim); font-size:16px;
  }
  .hero-ctas{display:flex; gap:14px; margin-top:30px; flex-wrap:wrap;}
  .btn{
    font-family:'JetBrains Mono',monospace; font-size:13px; letter-spacing:0.05em; text-transform:uppercase;
    padding:14px 26px; border-radius:3px; cursor:pointer; border:1px solid transparent;
    text-decoration:none; display:inline-flex; align-items:center; gap:8px;
    transition:transform .15s ease, background .2s ease, border-color .2s ease;
  }
  .btn:hover{transform:translateY(-2px);}
  .btn-primary{background:var(--pin-red); color:var(--cream);}
  .btn-primary:hover{background:var(--pin-red-light);}
  .btn-ghost{border-color:var(--line); color:var(--cream);}
  .btn-ghost:hover{border-color:var(--maple); color:var(--maple-light);}
  .btn-sm{padding:9px 16px; font-size:11px;}
  .btn:disabled{opacity:0.5; cursor:default; transform:none;}

  .lane-svg{width:100%; height:auto;}

  .brand-strip{
    display:flex; gap:26px; flex-wrap:wrap; margin-top:34px; padding-top:24px; border-top:1px solid var(--line);
    font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.12em; color:var(--steel); text-transform:uppercase;
  }
  .brand-strip b{color:var(--maple-light); font-weight:600;}

  .stats{border-top:1px solid var(--line); display:grid; grid-template-columns:repeat(4,1fr);}
  @media (max-width:700px){.stats{grid-template-columns:repeat(2,1fr);}}
  .stat{padding:26px 28px; border-right:1px solid var(--line);}
  .stat:last-child{border-right:none;}
  .stat .num{font-family:'JetBrains Mono',monospace; font-size:30px; color:var(--maple-light);}
  .stat .label{font-size:12px; letter-spacing:0.06em; text-transform:uppercase; color:var(--steel); margin-top:4px;}

  .lane-divider{width:100%; height:46px; margin:0; display:block;}

  .section-pad{padding:76px 0;}
  .section-head{max-width:640px; margin-bottom:44px; display:flex; justify-content:space-between; align-items:flex-end; gap:20px; flex-wrap:wrap;}
  .section-head .eyebrow{margin-bottom:14px;}
  .section-head h2{font-size:clamp(30px,4vw,44px);}
  .section-head p{color:var(--cream-dim); margin-top:14px; font-size:16px;}

  /* ---------- HOME extras ---------- */
  .locations{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
  @media (max-width:900px){.locations{grid-template-columns:1fr 1fr;}}
  @media (max-width:640px){.locations{grid-template-columns:1fr;}}
  .loc-card{background:var(--walnut-900); border:1px solid var(--line); border-radius:var(--radius); padding:24px; position:relative; overflow:hidden;}
  .loc-card::before{content:"";position:absolute; left:0; top:0; bottom:0; width:4px; background:var(--pin-red);}
  .loc-card h3{font-size:20px; color:var(--maple-light); margin-bottom:6px;}
  .loc-card .addr{color:var(--cream-dim); font-size:13.5px; margin-bottom:14px;}
  .loc-card .hours{font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--steel); display:flex; justify-content:space-between; padding:4px 0; border-top:1px dashed var(--line);}

  .meet{display:grid; grid-template-columns:0.9fr 1.1fr; gap:44px; align-items:center; margin-top:66px;}
  @media (max-width:800px){.meet{grid-template-columns:1fr;}}
  .meet-photo{aspect-ratio:4/5; border-radius:var(--radius); background:linear-gradient(160deg, var(--walnut-700), var(--walnut-900)); border:1px solid var(--line); display:flex; align-items:center; justify-content:center;}
  .meet-photo svg{width:58%; opacity:0.85;}
  .meet h3{font-size:28px; margin-bottom:14px;}
  .meet p{color:var(--cream-dim); margin-bottom:14px;}

  /* ---------- SHOP: PRODUCTS ---------- */
  .filter-row{display:flex; gap:8px; margin-bottom:30px; flex-wrap:wrap;}
  .filter-chip{
    font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.05em; text-transform:uppercase;
    border:1px solid var(--line); background:var(--walnut-900); color:var(--cream-dim);
    padding:9px 16px; border-radius:999px; cursor:pointer; transition:border-color .15s ease, color .15s ease, background .15s ease;
  }
  .filter-chip:hover{border-color:var(--maple);}
  .filter-chip.active{background:var(--pin-red); border-color:var(--pin-red); color:var(--cream);}

  .product-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
  @media (max-width:900px){.product-grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:620px){.product-grid{grid-template-columns:1fr;}}

  .product-card{background:var(--walnut-900); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; display:flex; flex-direction:column; transition:border-color .15s ease, transform .15s ease;}
  .product-card:hover{border-color:var(--maple); transform:translateY(-3px);}
  .product-media{aspect-ratio:1/1; background:radial-gradient(circle at 40% 35%, var(--walnut-700), var(--walnut-950)); display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;}
  .product-media img{width:78%; height:78%; object-fit:contain; filter:drop-shadow(0 10px 18px rgba(0,0,0,0.45));}
  .brand-tag{
    position:absolute; top:12px; left:12px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.1em;
    text-transform:uppercase; background:var(--walnut-950); border:1px solid var(--line); color:var(--maple-light);
    padding:4px 9px; border-radius:999px; z-index:2;
  }
  .product-body{padding:18px; display:flex; flex-direction:column; gap:6px; flex:1;}
  .product-name{font-family:'Work Sans',sans-serif; font-weight:700; font-size:15.5px; text-transform:none;}
  .product-sku{font-size:10.5px; color:var(--steel); letter-spacing:0.06em;}
  .product-desc{font-size:13px; color:var(--cream-dim); flex:1;}
  .product-price{font-family:'JetBrains Mono',monospace; font-size:16px; color:var(--maple-light); margin-top:2px;}
  .product-included{
    font-size:11.5px; color:var(--maple-light); background:rgba(217,161,91,0.12); border:1px solid rgba(217,161,91,0.3);
    border-radius:var(--radius); padding:6px 10px; display:inline-block;
  }
  .add-to-cart{width:100%; justify-content:center; margin-top:10px;}

  /* ---------- SERVICES page ---------- */
  .service-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
  @media (max-width:900px){.service-grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:600px){.service-grid{grid-template-columns:1fr;}}
  .service-card{background:var(--walnut-900); border:1px solid var(--line); border-radius:var(--radius); padding:22px; display:flex; flex-direction:column; gap:10px; transition:border-color .15s ease, transform .15s ease;}
  .service-card:hover{transform:translateY(-3px); border-color:var(--maple);}
  .service-card svg{width:28px;height:28px; color:var(--pin-red-light);}
  .service-card h3{font-size:16.5px; text-transform:none; font-family:'Work Sans',sans-serif; font-weight:700;}
  .service-card p{font-size:13.5px; color:var(--cream-dim); flex:1;}
  .service-price{font-family:'JetBrains Mono',monospace; font-size:15px; color:var(--maple-light);}
  .lessons-banner{
    margin-top:50px; background:linear-gradient(120deg, var(--walnut-800), var(--walnut-900));
    border:1px solid var(--line); border-radius:var(--radius); padding:30px; display:flex; justify-content:space-between; align-items:center; gap:20px; flex-wrap:wrap;
  }
  .lessons-banner h3{font-size:22px;}
  .lessons-banner p{color:var(--cream-dim); font-size:14px; margin-top:6px; max-width:440px;}

  /* ---------- REVIEWS ---------- */
  .review-summary{display:flex; align-items:center; gap:22px; margin-bottom:40px; flex-wrap:wrap;}
  .rev-score{font-family:'Anton',sans-serif; font-size:56px; color:var(--maple-light); line-height:1;}
  .stars{color:var(--maple); font-size:18px; letter-spacing:2px;}
  .review-grid{columns:3 320px; column-gap:20px;}
  @media (max-width:700px){.review-grid{columns:1;}}
  .review-card{break-inside:avoid; background:var(--walnut-900); border:1px solid var(--line); border-radius:var(--radius); padding:20px; margin-bottom:20px;}
  .rev-head{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;}
  .rev-name{font-weight:600; font-size:14.5px; color:var(--cream);}
  .rev-meta{font-size:12px; color:var(--steel); margin-top:2px;}
  .rev-time{font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--steel); white-space:nowrap;}
  .rev-stars{color:var(--maple); font-size:13px; margin-bottom:8px; letter-spacing:1px;}
  .rev-text{font-size:14px; color:var(--cream-dim); line-height:1.55;}
  .rev-reply{margin-top:12px; padding:12px 14px; background:var(--walnut-800); border-left:3px solid var(--pin-red); border-radius:2px; font-size:13px; color:var(--cream-dim);}
  .rev-reply b{color:var(--cream); font-weight:600; font-size:12.5px;}
  .google-cta{text-align:center; margin-top:20px;}

  /* ---------- FOOTER ---------- */
  footer{border-top:1px solid var(--line); background:var(--walnut-900); padding:50px 0 30px;}
  .footer-grid{display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:40px;}
  @media (max-width:700px){.footer-grid{grid-template-columns:1fr; gap:30px;}}
  footer h4{font-size:13px; letter-spacing:0.08em; color:var(--maple); margin-bottom:14px; text-transform:uppercase; font-family:'JetBrains Mono',monospace;}
  footer p, footer a{font-size:14px; color:var(--cream-dim); text-decoration:none; display:block; margin-bottom:8px;}
  footer a:hover{color:var(--maple-light);}
  .footer-bottom{border-top:1px solid var(--line); margin-top:36px; padding-top:20px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; font-size:12px; color:var(--steel); font-family:'JetBrains Mono',monospace;}

  .toast{
    position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px); opacity:0;
    background:var(--pin-red); color:var(--cream); padding:12px 22px; border-radius:999px; font-size:13px;
    font-family:'JetBrains Mono',monospace; z-index:90; transition:all .3s ease; pointer-events:none;
  }
  .toast.show{opacity:1; transform:translateX(-50%) translateY(0);}

  :focus-visible{outline:2px solid var(--maple); outline-offset:3px;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.01ms !important; transition-duration:0.01ms !important;}
  }
</style>
</head>
<body>

<header>
  <div class="nav">
    <div class="brand">
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="24" cy="24" r="22" fill="#af2436"/>
        <circle cx="24" cy="24" r="15" fill="#f3e8d3"/>
        <circle cx="19" cy="18" r="2.2" fill="#221609"/>
        <circle cx="26" cy="16" r="2.2" fill="#221609"/>
        <circle cx="22" cy="24" r="2.2" fill="#221609"/>
      </svg>
      <div class="brand-text">
        <span class="k1">Kurt's Pro Shop</span>
        <span class="k2">"Where Bowlers Come First"</span>
      </div>
    </div>

    <nav class="tabs" id="tabs">
      <button class="tab-btn active" data-target="home">Home</button>
      <button class="tab-btn" data-target="shop">Shop</button>
      <button class="tab-btn" data-target="services">Services</button>
      <button class="tab-btn" data-target="reviews">Reviews</button>
    </nav>

    <div class="nav-right">
      <a class="fb-link" href="https://www.facebook.com/bowlerschooseKPS" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.9h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z"/></svg>
        <span>Facebook</span>
      </a>
      <button class="cart-btn" id="cartBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M1 1h4l2.6 13.4a2 2 0 0 0 2 1.6h9.4a2 2 0 0 0 2-1.6L23 6H6"/></svg>
        <span>Cart</span>
        <span class="cart-count mono" id="cartCount">0</span>
      </button>
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">☰</button>
    </div>
  </div>
</header>

<div class="overlay" id="overlay"></div>
<div class="cart-drawer" id="cartDrawer">
  <div class="cart-head">
    <h3>Your Cart</h3>
    <button class="cart-close" id="cartClose">✕</button>
  </div>
  <div class="cart-items" id="cartItems"></div>
  <div class="cart-foot">
