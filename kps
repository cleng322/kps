    el.addEventListener('click', (e)=>{ e.preventDefault(); goto(el.dataset.goto); });
  });
  document.getElementById('menuToggle').addEventListener('click', ()=>{
    document.getElementById('tabs').classList.toggle('open');
  });

  /* ---------------- product data (real Brunswick / Motiv / Storm balls) ---------------- */
  const DRILL_PRICE = 65;
  const products = [
    { sku:'BRW-17986', brand:'Brunswick', name:'Brunswick Danger Zone', desc:'Asymmetric core built for a strong, angular backend move on medium-heavy oil.', ballPrice:119.95, img:'https://images1.bowlingball.com/images/Product/medium/17986.jpg' },
    { sku:'BRW-12492', brand:'Brunswick', name:'Brunswick Rhino Red/Black/Gold', desc:'Entry-level workhorse — predictable shape, easy to control, great first ball.', ballPrice:89.99, img:'https://images1.bowlingball.com/images/Product/medium/12492.jpg' },
    { sku:'BRW-17958', brand:'Brunswick', name:'Brunswick Alert', desc:'Symmetric core with a strong, continuous shape through the midlane.', ballPrice:159.95, img:'https://images1.bowlingball.com/images/Product/medium/17958.jpg' },
    { sku:'MTV-18171', brand:'Motiv', name:'Motiv Venom Hysteria', desc:'High-flare asymmetric for heavy-oil league conditions.', ballPrice:184.95, img:'https://images1.bowlingball.com/images/Product/medium/18171.jpg' },
    { sku:'MTV-18389', brand:'Motiv', name:'Motiv Jackal Ghost V2', desc:'Smooth, controllable motion for medium-to-heavy house shots.', ballPrice:219.95, img:'https://images1.bowlingball.com/images/Product/medium/18389.jpg' },
    { sku:'MTV-18371', brand:'Motiv', name:'Motiv Sigma Tour Pearl', desc:'Benchmark tour-level performance with a strong midlane read.', ballPrice:204.95, img:'https://images1.bowlingball.com/images/Product/medium/18371.jpg' },
    { sku:'STM-18002', brand:'Storm', name:'Storm Bionic', desc:'Angular asymmetric shape for a sharp, controlled backend.', ballPrice:184.95, img:'https://images1.bowlingball.com/images/Product/medium/18002.jpg' },
    { sku:'STM-10351', brand:'Storm', name:'Storm IQ Tour', desc:'Classic symmetric workhorse — smooth arc, easy to read.', ballPrice:164.99, img:'https://images1.bowlingball.com/images/Product/medium/10351.jpg' },
    { sku:'STM-18195', brand:'Storm', name:'Storm Alpha Crux (2026)', desc:'Tour-level asymmetric for bowlers who play the whole lane.', ballPrice:209.95, img:'https://images1.bowlingball.com/images/Product/medium/18195.jpg' },
  ];

  const productGrid = document.getElementById('productGrid');
  function renderProducts(filter){
    productGrid.innerHTML = products
      .filter(p => filter==='all' || p.brand===filter)
      .map(p => {
        const total = (p.ballPrice + DRILL_PRICE).toFixed(2);
        return `
        <div class="product-card">
          <div class="product-media">
            <span class="brand-tag">${p.brand}</span>
            <img src="${p.img}" alt="${p.name}" loading="lazy" onerror="this.style.display='none'">
          </div>
          <div class="product-body">
            <div class="product-name">${p.name}</div>
            <div class="product-sku mono">SKU ${p.sku}</div>
            <div class="product-desc">${p.desc}</div>
            <div class="product-price mono">$${total}</div>
            <div class="product-included">Includes drilling &amp; fitting by Kurt</div>
            <button class="btn btn-primary add-to-cart" data-id="${p.sku}">Add To Cart</button>
          </div>
        </div>
      `;}).join('');
  }
  renderProducts('all');

  document.getElementById('filterRow').addEventListener('click', (e)=>{
    const chip = e.target.closest('.filter-chip');
    if(!chip) return;
    document.querySelectorAll('.filter-chip').forEach(c=>c.classList.remove('active'));
    chip.classList.add('active');
    renderProducts(chip.dataset.brand);
  });

  productGrid.addEventListener('click', (e)=>{
    const btn = e.target.closest('.add-to-cart');
    if(!btn) return;
    const p = products.find(x=>x.sku===btn.dataset.id);
    const total = +(p.ballPrice + DRILL_PRICE).toFixed(2);
    addToCart({
      key: p.sku + '-' + Date.now(),
      name: p.name,
      meta: p.brand + ' · SKU ' + p.sku + ' · Drilling & Fitting Included',
      price: total,
      img: p.img
    });
    showToast(p.name + ' added to cart');
  });

  /* ---------------- service data ---------------- */
  const serviceIcons = {
    fit: '<circle cx="12" cy="12" r="9"/><circle cx="9" cy="9" r="1"/><circle cx="14" cy="8" r="1"/><circle cx="11" cy="13" r="1"/>',
    redrill: '<path d="M3 12h4l3 8 4-16 3 8h4"/>',
    surface: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 10h16"/>',
    grip: '<path d="M4 6h16M4 12h16M4 18h10"/>',
    rush: '<path d="M13 2 3 14h7l-1 8 11-14h-7l1-6z"/>',
    plug: '<circle cx="12" cy="12" r="9"/><path d="M12 7v10M7 12h10"/>',
    clean: '<path d="M7 3v6M7 9c-2 1.5-3 3.5-3 6a5 5 0 0 0 10 0c0-2.5-1-4.5-3-6"/><path d="M4 20h6"/>'
  };
  const services = [
    { id:'svc-fit', icon:'fit', name:'Fitting Only', desc:'Full hand-span and grip measurement, no drilling.', price:25 },
    { id:'svc-redrill', icon:'redrill', name:'Plug & Redrill', desc:'Fill existing holes and drill a fresh layout.', price:55 },
    { id:'svc-surface', icon:'surface', name:'Surface Adjustment', desc:'Tune grit and finish to match your house condition.', price:15 },
    { id:'svc-clean', icon:'clean', name:'Ball Cleaning', desc:'Deep clean to strip embedded oil and restore surface tack.', price:12 },
    { id:'svc-grip', icon:'grip', name:'Grip Adjustment', desc:'Tweak span, pitch, or hole size on a ball you already own.', price:20 },
    { id:'svc-rush', icon:'rush', name:'Rush Service', desc:'Same-day turnaround, subject to shop schedule.', price:20 },
    { id:'svc-plug', icon:'plug', name:'Custom Layout Upgrade', desc:'Pin-to-PAP or dual-angle layout on your next drill.', price:20 },
  ];
  const serviceGrid = document.getElementById('serviceGrid');
  serviceGrid.innerHTML = services.map(s => `
    <div class="service-card">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${serviceIcons[s.icon]}</svg>
